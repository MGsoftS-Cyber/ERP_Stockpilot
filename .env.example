DJANGO_SECRET_KEY=replace-this-in-production
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,backend
DATABASE_URL=postgresql://stockpilot:stockpilot@db:5432/stockpilot
CORS_ALLOWED_ORIGINS=http://localhost:5173
VITE_API_URL=http://localhost:3000/api/v1
VITE_AUTH_MODE=oidc
VITE_OIDC_ISSUER=http://localhost:9000
VITE_WS_URL=ws://localhost:3000/ws
OIDC_ISSUER=http://localhost:9000
WEB_ORIGIN=http://localhost:5173
# False preserves real existing records. True explicitly seeds demonstration data.
SEED_DEMO=false
# Compose sets AUTH_MODE=oidc and private internal JWKS URLs for the services.
# Direct local Django development still defaults to legacy mode for isolated old tests.
POSTGRES_DB=stockpilot
POSTGRES_USER=stockpilot
POSTGRES_PASSWORD=stockpilot
